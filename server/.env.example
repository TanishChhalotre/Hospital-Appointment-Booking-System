# ── MongoDB ───────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string
MONGODB_URI=your_mongodb_atlas_connection_string

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must be at least 32 characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=at_least_32_random_characters

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000

# Only needed if the frontend is hosted SEPARATELY from this API (cross-origin).
# When the API serves the built frontend itself (the Render single-service
# deploy), same-origin requests are always allowed, so this can stay at the
# local-dev default.
CLIENT_URL=http://localhost:5173

# ── Seed ──────────────────────────────────────────────────────────────────────
# Creates demonstration hospital, department, doctor and patient records if
# they do not exist. Keep true for demo purposes only.
SEED_DATABASE=true

# ── Email (OTP) ───────────────────────────────────────────────────────────────
# For Gmail: enable 2FA on your account, then create an App Password at
# https://myaccount.google.com/apppasswords
# Use that 16-character App Password as SMTP_PASS (not your real Gmail password).
# Note: this app connects with implicit TLS (secure: true), so use port 465,
# not 587 (587 is for STARTTLS).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your_16_character_app_password
